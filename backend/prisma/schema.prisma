datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model WeatherSearch {
  id              String   @id @default(uuid())
  location        String
  startDate       String?
  endDate         String?
  temperatureData String?
  alias           String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
